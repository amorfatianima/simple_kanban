{
  "compilerOptions": {
    "baseUrl": "./",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ES2020"],
    "types": ["node"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "useDefineForClassFields": false
  },
  "include": ["src"]
}
